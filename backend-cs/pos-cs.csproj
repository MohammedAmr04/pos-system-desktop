<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>PosCs</RootNamespace>
    <AssemblyName>pos-server</AssemblyName>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <RestorePackages>true</RestorePackages>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Management" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="Pos.Domain\Pos.Domain.csproj" />
    <ProjectReference Include="Pos.Application\Pos.Application.csproj" />
    <ProjectReference Include="Pos.Infrastructure\Pos.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Sibling projects compile their own sources; keep them out of this project's globs. -->
    <Compile Remove="Pos.Domain\**;Pos.Application\**;Pos.Infrastructure\**;Pos.Tests\**" />
    <None Remove="Pos.Domain\**;Pos.Application\**;Pos.Infrastructure\**;Pos.Tests\**" />
    <EmbeddedResource Remove="Pos.Domain\**;Pos.Application\**;Pos.Infrastructure\**;Pos.Tests\**" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Database\Migrations\*.sql">
      <Link>Migrations\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNet.WebApi.OwinSelfHost" Version="5.3.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.3" />
    <PackageReference Include="Microsoft.Owin.Cors" Version="4.2.2" />
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="Microsoft.Owin.StaticFiles" Version="4.2.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <Target Name="CopyNativeSqlite" AfterTargets="Build">
    <Copy SourceFiles="$(UserProfile)\.nuget\packages\SQLitePCLRaw.lib.e_sqlite3\2.1.10\runtimes\win-x64\native\e_sqlite3.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <MakeDir Directories="$(OutDir)runtimes\win-x64\native\" />
    <Copy SourceFiles="$(UserProfile)\.nuget\packages\SQLitePCLRaw.lib.e_sqlite3\2.1.10\runtimes\win-x64\native\e_sqlite3.dll" DestinationFolder="$(OutDir)runtimes\win-x64\native\" SkipUnchangedFiles="true" />
  </Target>
</Project>
