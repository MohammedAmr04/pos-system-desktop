# API base URL used by the Next.js static export at build time.
# In production the backend serves the SPA on the same origin, so this
# should point to the running backend (http://localhost:3001 by default).
NEXT_PUBLIC_API_URL=http://localhost:3001

# Backend license-signing secret. MUST be set in production and must NOT be
# committed to source control. Generate a strong random string and keep it in
# sync with license.secret next to pos-server.exe.
POS_LICENSE_SECRET=change-this-to-a-random-secret-in-production
