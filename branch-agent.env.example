# Copy this file to branch-agent.env on the branch computer.
# The branch identity and sync key come from the local setup screen.
POS_CENTRAL_URL=https://pos.example.com
POS_BRANCH_LOCAL_URL=http://localhost:3001
POS_SYNC_POLL_SECONDS=5

# Optional installation label used by older installations.
# POS_BRANCH_ID=friboles
