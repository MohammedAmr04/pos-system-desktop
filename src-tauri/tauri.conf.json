{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "pos-app",
  "version": "0.1.0",
  "identifier": "com.pos.app",
 
  
  "build": {
    "beforeBuildCommand": "powershell -ExecutionPolicy Bypass -File build-next-standalone.ps1",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "frontendDist": "http://localhost:3000"
  },

  "app": {
    "windows": [
      {
        "title": "POS System",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "bin/node"
    ],
    "resources": [
      "../.next/standalone/**/*"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
